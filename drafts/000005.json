      },
      {
        "speaker": "char.tenmatsuyora",
        "to": [
          "char.anton"
        ],
        "heard": [
          "char.anton"
        ],
        "comprehension": "Просьба о приватности.",
        "source": {
          "paragraph": 90,
          "start": 0,
          "end": 41,
          "quote": "— Мне нужна ширма, — сказала она наконец."
