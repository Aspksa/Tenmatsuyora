      },
      {
        "speaker": "char.tenmatsuyora",
        "to": [
          "char.anton"
        ],
        "heard": [
          "char.anton"
        ],
        "comprehension": "Уточняет отсутствие шока.",
        "source": {
          "paragraph": 78,
          "start": 0,
          "end": 28,
          "quote": "— Когда касались моего лица."
