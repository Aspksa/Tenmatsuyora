      },
      {
        "speaker": "char.tenmatsuyora",
        "to": [
          "char.anton"
        ],
        "heard": [
          "char.anton"
        ],
        "comprehension": "Право остановить.",
        "source": {
          "paragraph": 21,
          "start": 0,
          "end": 33,
          "quote": "— И прекратите, когда я потребую."
